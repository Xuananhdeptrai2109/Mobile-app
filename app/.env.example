# ============================================
# EXPENSE MANAGEMENT FRONTEND (ANDROID) - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# These values will be loaded by build.gradle.kts into BuildConfig

# ============================================
# API CONFIGURATION
# ============================================
# For Android Emulator, use: http://10.0.2.2:8081/api/
# For Physical Device, use: http://your_machine_ip:8081/api/
API_BASE_URL=http://10.0.2.2:8081/api/
API_BASE_URL_RELEASE=https://your-production-api.com/api/
API_TIMEOUT=30
API_LOG_LEVEL=BODY

# Required only for a signed release build. Keep passwords in local .env or CI
# secrets; never commit a real keystore or credentials.
RELEASE_STORE_FILE=C:/secure/path/moneycare-release.jks
RELEASE_STORE_PASSWORD=replace_me
RELEASE_KEY_ALIAS=moneycare
RELEASE_KEY_PASSWORD=replace_me

# ============================================
# APP CONFIGURATION
# ============================================
APP_VERSION=1.0
DEBUG_MODE=true

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false

# ============================================
# For Production:
# ============================================
# API_BASE_URL=https://your_production_api.com/api/
# DEBUG_MODE=false
# ENABLE_ANALYTICS=true
# APP_VERSION=2.0
