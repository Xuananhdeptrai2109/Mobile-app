# ============================================
# EXPENSE MANAGEMENT BACKEND - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SPRING PROFILE (dev or prod)
# ============================================
SPRING_PROFILES_ACTIVE=dev

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moneycare_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_PORT=8081
SERVER_SERVLET_CONTEXT_PATH=/api

# ============================================
# JPA/HIBERNATE CONFIGURATION
# ============================================
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_USE_SQL_COMMENTS=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_HIBERNATE_SQL=WARN
LOG_LEVEL_HIBERNATE_BINDER=WARN
SPRING_BOOT_DEBUG=false

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:8081
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# GEMINI CONFIGURATION
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# SECURITY CONFIGURATION
# ============================================
SECURITY_FILTER_ORDER=5

# For Production:
# SPRING_PROFILES_ACTIVE=prod
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# LOG_LEVEL_ROOT=INFO
# JWT authentication (use a random secret of at least 32 bytes)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=moneycare-api
JWT_TTL_SECONDS=86400
